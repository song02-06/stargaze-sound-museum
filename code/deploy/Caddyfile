# 星轨 · 声音博物馆 —— Caddy 反向代理
#
# 作用：
#   https://你的域名/          → 前端 dist（SPA，深层路由回落 index.html）
#   https://你的域名/api/*     → Spring Boot（不剥前缀）
#   https://你的域名/audio/*   → Spring Boot（不剥前缀，支持 Range 拖动）
#
# 换成服务器实际域名（Caddy 会为它自动申请 HTTPS 证书，DNS 要指向这台机器，
# 并且 80/443 要放通）。
museum.example.com {
	encode gzip

	# API 与音频走反向代理。注意：这里**不能**用 strip 前缀的写法，
	# 后端控制器注册的就是 /api/**，前缀被剥掉就 404。
	@backend path /api/* /audio/*
	handle @backend {
		reverse_proxy 127.0.0.1:8081
	}

	# 其余全部给前端。createWebHistory 需要 try_files 回落 ——
	# 直接刷新 /mine、/exhibit/0249、/admin 时，磁盘上没有那个文件，
	# 必须回 index.html 交给 vue-router 处理。
	handle {
		root * /srv/starmuseum/web
		try_files {path} /index.html
		file_server
	}

	# 前端资源带内容哈希，可以长缓存；index.html 不能缓存，
	# 否则发版之后浏览器还拿着旧入口去请求已经删掉的资源。
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
