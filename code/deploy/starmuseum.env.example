# 星轨 · 声音博物馆 —— 服务器环境变量示例
#
# 复制到 /etc/starmuseum/starmuseum.env，改成真实值，然后：
#   sudo chown starmuseum:starmuseum /etc/starmuseum/starmuseum.env
#   sudo chmod 600 /etc/starmuseum/starmuseum.env
#
# ⚠️ 这个文件本身不要提交 Git，也不要把真实密钥写进本示例。

# ---------- 监听 ----------
# 只监听本机回环：对外由 Caddy 提供 HTTPS，后端不直接暴露在公网
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081

# ---------- 持久化：必须用绝对路径 ----------
# 数据库与音频都放在发布目录之外，替换 jar / dist 时不会被覆盖
SPRING_DATASOURCE_URL=jdbc:h2:file:/srv/starmuseum/data/museum
MUSEUM_AUDIO_ROOT=/srv/starmuseum/data/audio

# ---------- 管理口 ----------
# 留空 = 管理后台关闭（安全默认）。
# 要启用就必须设成一段足够长的随机字符串，否则 /admin 进不去：
#   openssl rand -base64 24
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# ---------- 语音识别（可选） ----------
# mock（默认）= 不联网、不需要密钥。**它不是识别**：
#   语音回音在 mock 下一律转人工复审，不会生成假的转写文本。
# baidu = 百度短语音识别。只有在真实密钥 + 真人录音验证识别文本确实对应音频之后，
#   才把 provider 改成 baidu —— 否则保持 mock。
ASR_PROVIDER=mock
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ---------- 展签压缩（可选） ----------
# mock（默认）= 本地确定性压缩，只做减法，可离线
# remote = 调 OpenAI 兼容接口；输出仍要过 SignGuard，过不了会退回 mock。
# 真实远程压缩是加分能力，不是投稿成功的必需条件。
MUSEUM_SIGN_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
